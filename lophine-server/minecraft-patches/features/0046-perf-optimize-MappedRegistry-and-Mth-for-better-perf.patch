From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GoldenCarrotMC <tbcnb650388@gmail.com>
Date: Sat, 18 Apr 2026 15:53:07 +0800
Subject: [PATCH] perf: optimize MappedRegistry and Mth for better performance


diff --git a/net/minecraft/core/MappedRegistry.java b/net/minecraft/core/MappedRegistry.java
index ad1558693564ebd18f5e16b85ae552d2af95efef..b10636ef68438ce74d2112d09f2bb5b327539a9f 100644
--- a/net/minecraft/core/MappedRegistry.java
+++ b/net/minecraft/core/MappedRegistry.java
@@ -6,6 +6,8 @@ import com.google.common.collect.ImmutableMap.Builder;
 import com.mojang.serialization.Lifecycle;
 import it.unimi.dsi.fastutil.objects.ObjectArrayList;
 import it.unimi.dsi.fastutil.objects.ObjectList;
+import it.unimi.dsi.fastutil.ints.Int2ObjectMap; // Lophine
+import it.unimi.dsi.fastutil.ints.Int2ObjectOpenHashMap; // Lophine
 import it.unimi.dsi.fastutil.objects.Reference2IntMap;
 import it.unimi.dsi.fastutil.objects.Reference2IntOpenHashMap;
 import java.util.ArrayList;
@@ -35,7 +37,8 @@ public class MappedRegistry<T> implements WritableRegistry<T> {
     private final Reference2IntMap<T> toId = Util.make(new Reference2IntOpenHashMap<>(2048), map -> map.defaultReturnValue(-1)); // Paper - Perf: Use bigger expected size to reduce collisions
     private final Map<Identifier, Holder.Reference<T>> byLocation = new HashMap<>(2048); // Paper - Perf: Use bigger expected size to reduce collisions
     private final Map<ResourceKey<T>, Holder.Reference<T>> byKey = new HashMap<>(2048); // Paper - Perf: Use bigger expected size to reduce collisions
-    private final Map<T, Holder.Reference<T>> byValue = new IdentityHashMap<>(2048); // Paper - Perf: Use bigger expected size to reduce collisions
+    private final @Nullable Map<T, Holder.Reference<T>> byValue; // Paper - Perf: Use bigger expected size to reduce collisions // Lophine - allow null
+    private final @Nullable Int2ObjectMap<Holder.Reference<T>> byIdPrimitive; // Lophine - primitive bimap
     private final Map<ResourceKey<T>, RegistrationInfo> registrationInfos = new IdentityHashMap<>(2048); // Paper - Perf: Use bigger expected size to reduce collisions
     private Lifecycle registryLifecycle;
     private final Map<TagKey<T>, HolderSet.Named<T>> frozenTags = new IdentityHashMap<>();
@@ -79,6 +82,15 @@ public class MappedRegistry<T> implements WritableRegistry<T> {
         if (hasIntrusiveHolders) {
             this.unregisteredIntrusiveHolders = new IdentityHashMap<>();
         }
+        // Lophine start - primitive bimap
+        if (fun.bm.lophine.config.modules.experiment.FoliaOptimizationConfig.primitiveBimap) {
+            this.byIdPrimitive = new Int2ObjectOpenHashMap<>(2048);
+            this.byValue = null;
+        } else {
+            this.byIdPrimitive = null;
+            this.byValue = new IdentityHashMap<>(2048);
+        }
+        // Lophine end
     }
 
     @Override
@@ -110,7 +122,7 @@ public class MappedRegistry<T> implements WritableRegistry<T> {
         Objects.requireNonNull(value);
         if (this.byLocation.containsKey(key.identifier())) {
             throw (IllegalStateException)Util.pauseInIde(new IllegalStateException("Adding duplicate key '" + key + "' to registry"));
-        } else if (this.byValue.containsKey(value)) {
+        } else if (this.toId.containsKey(value)) { // Lophine - primitive bimap - use toId for O(1) check
             throw (IllegalStateException)Util.pauseInIde(new IllegalStateException("Adding duplicate value '" + value + "' to registry"));
         } else {
             Holder.Reference<T> reference;
@@ -127,7 +139,11 @@ public class MappedRegistry<T> implements WritableRegistry<T> {
 
             this.byKey.put(key, reference);
             this.byLocation.put(key.identifier(), reference);
-            this.byValue.put(value, reference);
+            if (this.byIdPrimitive != null) {
+                this.byIdPrimitive.put(this.byId.size(), reference);
+            } else {
+                this.byValue.put(value, reference);
+            }
             int size = this.byId.size();
             this.byId.add(reference);
             this.toId.put(value, size);
@@ -141,13 +157,14 @@ public class MappedRegistry<T> implements WritableRegistry<T> {
 
     @Override
     public @Nullable Identifier getKey(T value) {
-        Holder.Reference<T> reference = this.byValue.get(value);
+        Holder.Reference<T> reference = this.byIdPrimitive != null ? this.byIdPrimitive.get(this.toId.getInt(value)) : this.byValue.get(value); // Lophine - primitive bimap
         return reference != null ? reference.key().identifier() : null;
     }
 
     @Override
     public Optional<ResourceKey<T>> getResourceKey(T value) {
-        return Optional.ofNullable(this.byValue.get(value)).map(Holder.Reference::key);
+        Holder.Reference<T> reference = this.byIdPrimitive != null ? this.byIdPrimitive.get(this.toId.getInt(value)) : this.byValue.get(value); // Lophine - primitive bimap
+        return Optional.ofNullable(reference).map(Holder.Reference::key);
     }
 
     @Override
@@ -162,11 +179,18 @@ public class MappedRegistry<T> implements WritableRegistry<T> {
 
     @Override
     public @Nullable T byId(int id) {
+        if (this.byIdPrimitive != null) {
+            Holder.Reference<T> reference = this.byIdPrimitive.get(id);
+            return reference != null ? reference.value() : null;
+        }
         return id >= 0 && id < this.byId.size() ? this.byId.get(id).value() : null;
     }
 
     @Override
     public Optional<Holder.Reference<T>> get(int index) {
+        if (this.byIdPrimitive != null) {
+            return Optional.ofNullable(this.byIdPrimitive.get(index));
+        }
         return index >= 0 && index < this.byId.size() ? Optional.ofNullable(this.byId.get(index)) : Optional.empty();
     }
 
@@ -187,7 +211,7 @@ public class MappedRegistry<T> implements WritableRegistry<T> {
 
     @Override
     public Holder<T> wrapAsHolder(T value) {
-        Holder.Reference<T> reference = this.byValue.get(value);
+        Holder.Reference<T> reference = this.byIdPrimitive != null ? this.byIdPrimitive.get(this.toId.getInt(value)) : this.byValue.get(value); // Lophine - primitive bimap
         return (Holder<T>)(reference != null ? reference : Holder.direct(value));
     }
 
@@ -292,7 +316,18 @@ public class MappedRegistry<T> implements WritableRegistry<T> {
         } else {
             this.frozen = true;
             this.temporaryUnfrozenMap.clear(); // Paper - support pre-filling in registry mod API
-            this.byValue.forEach((object, reference) -> reference.bindValue((T)object));
+            // Lophine start - primitive bimap
+            if (this.byIdPrimitive != null) {
+                this.toId.forEach((object, id) -> {
+                    Holder.Reference<T> reference = this.byIdPrimitive.get(id.intValue());
+                    if (reference != null) {
+                        reference.bindValue(object);
+                    }
+                });
+            } else {
+                this.byValue.forEach((object, reference) -> reference.bindValue((T)object));
+            }
+            // Lophine end
             List<Identifier> list = this.byKey
                 .entrySet()
                 .stream()
diff --git a/net/minecraft/util/Mth.java b/net/minecraft/util/Mth.java
index 01794b0a4b532971149f30f76f6e9b91d21a21ee..a3ce7310f8341906fe482660d54ef47c2e9972b6 100644
--- a/net/minecraft/util/Mth.java
+++ b/net/minecraft/util/Mth.java
@@ -36,6 +36,14 @@ public class Mth {
             floats[i1] = (float)Math.sin(i1 / 10430.378350470453);
         }
     });
+    // Lophine start - compact sine lut
+    private static final float[] COMPACT_SIN = new float[4096];
+    static {
+        for (int i = 0; i < 4096; i++) {
+            COMPACT_SIN[i] = (float)Math.sin((double)i * Math.PI * 2.0D / 4096.0D);
+        }
+    }
+    // Lophine end
     private static final RandomSource RANDOM = RandomSource.createThreadSafe();
     private static final int[] MULTIPLY_DE_BRUIJN_BIT_POSITION = new int[]{
         0, 1, 28, 2, 29, 14, 24, 3, 30, 22, 20, 15, 25, 17, 4, 8, 31, 27, 13, 23, 21, 19, 16, 7, 26, 12, 18, 6, 11, 5, 10, 9
@@ -47,11 +55,31 @@ public class Mth {
     private static final double[] ASIN_TAB = new double[257];
     private static final double[] COS_TAB = new double[257];
 
+    public static float sin(float value) {
+        if (fun.bm.lophine.config.modules.experiment.FoliaOptimizationConfig.compactSineLut) {
+            return COMPACT_SIN[(int)(value * 651.8986F) & 4095];
+        }
+        return SIN[(int)(value * 10430.378F) & 65535];
+    }
+
     public static float sin(double value) {
+        if (fun.bm.lophine.config.modules.experiment.FoliaOptimizationConfig.compactSineLut) {
+            return COMPACT_SIN[(int)(value * 651.8986F) & 4095];
+        }
         return SIN[(int)((long)(value * 10430.378350470453) & 65535L)];
     }
 
+    public static float cos(float value) {
+        if (fun.bm.lophine.config.modules.experiment.FoliaOptimizationConfig.compactSineLut) {
+            return COMPACT_SIN[(int)(value * 651.8986F + 1024.0F) & 4095];
+        }
+        return SIN[(int)(value * 10430.378F + 16384.0F) & 65535];
+    }
+
     public static float cos(double value) {
+        if (fun.bm.lophine.config.modules.experiment.FoliaOptimizationConfig.compactSineLut) {
+            return COMPACT_SIN[(int)(value * 651.8986F + 1024.0F) & 4095];
+        }
         return SIN[(int)((long)(value * 10430.378350470453 + 16384.0) & 65535L)];
     }
 
